<mvc:View height="100%" controllerName="zaidgsmmsup.controller.OverViewPage"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:chart="sap.suite.ui.commons"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:layout="sap.ui.layout"
    xmlns:smartchart="sap.ui.comp.smartchart">
    <f:DynamicPage id="dynamicPage1" stickySubheaderProvider="ShoppingCartWizard" class="sapUiNoContentPadding" showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Service Master Mass Upload" />
                </f:heading>
                <f:expandedContent>
                    <Title id="idRequest" text="" />
                </f:expandedContent>

                <f:content>
                    <OverflowToolbar>
                        <GenericTag text="Total" status="None" design="StatusIconHidden" class="sapUiMediumMarginBegin" visible="{graphStatsModel>/visible}">
                            <ObjectNumber number="{graphStatsModel>/totalCount}" emphasized="false" state="None" />
                        </GenericTag>

                        <GenericTag text="Errors" status="Error" design="StatusIconHidden" class="sapUiMediumMarginBegin" visible="{graphStatsModel>/visible}">
                            <ObjectNumber number="{graphStatsModel>/errorCount}" emphasized="false" state="Error" />
                        </GenericTag>

                        <GenericTag text="Without Errors" status="Success" design="StatusIconHidden" class="sapUiMediumMarginBegin" visible="{graphStatsModel>/visible}">
                            <ObjectNumber number="{graphStatsModel>/noErrorCount}" emphasized="false" state="Success" />
                        </GenericTag>
                    </OverflowToolbar>
                </f:content>
            </f:DynamicPageTitle>
        </f:title>
        <f:header />
        <f:content>
            <VBox class="FreeBackground" alignContent="Center" justifyContent="Center" height="100%" backgroundDesign="Solid">
                <VBox alignContent="Center" justifyContent="Center" height="100%" backgroundDesign="Solid">
                    <HBox fitContainer="true" class="sapUiMediumMargin" alignContent="Center" justifyContent="Center" backgroundDesign="Transparent">
                        <VBox width="30%" height="50vh" class="sapUiSmallMarginEnd" fitContainer="false" backgroundDesign="Transparent">
                            <smartchart:SmartChart class="sapUiMediumMarginEnd" id="smartErrorChart" enableAutoBinding="true" entitySet="ZI_QU_DG_SM_Errorcount" header="Results" showFullScreenButton="false" selectionMode="Single" showChartTooltip="true" showDrillBreadcrumbs="false" showDetailsButton="false" showDrillButtons="false" showSemanticNavigationButton="false" height="40vh" beforeRebindChart="onBeforeRebindChart" showLegendButton="false" requestAtLeastFields="Errors,Without_Errors" useChartPersonalisation="false" showZoomButtons="false" showChartTypeSelectionButton="false" />
                        </VBox>
                        <VBox width="70%" backgroundDesign="Transparent">
                            <ScrollContainer height="50vh" width="auto" horizontal="false" vertical="true">
                                <smartTable:SmartTable id="smartErrorTable" entitySet="ZP_QU_DG_SMROOT" tableType="ResponsiveTable" header="Service Materials" showRowCount="true" enableAutoBinding="true" beforeRebindTable="onBeforeRebindTable" showTablePersonalisation="true" fitContainer="true" useInfoToolbar="Auto" enableExport="true" beforeExport="onBeforeExportExcel" useTablePersonalisation="true" demandPopin="true" useVariantManagement="true" placeToolbarInTable="true" enableAutoColumnWidth="true" height="50vh" requestAtLeastFields="mass_upld_error,asnum,meins,astyp,asktx,IsActiveEntity,s_no">
                                    <smartTable:customToolbar>
                                        <OverflowToolbar id="_IDGenOverflowToolbar12" design="Transparent">
                                            <ToolbarSpacer />
                                            <SearchField width="50%" change="onLiveChange" id="liveSearchFilter" />
                                            <ToolbarSpacer />
                                        </OverflowToolbar>
                                    </smartTable:customToolbar>
                                    <Table id="idErrorTable" growing="true" sticky="ColumnHeaders,HeaderToolbar,InfoToolbar" growingScrollToLoad="true">
                                        <columns>
                                            <Column id='draft' width="120px">
                                                <customData>
                                                    <core:CustomData key="p13nData" value='\{"columnKey": "asnum", "columnIndex": 0, "columnWidth": "120px","leadingProperty": "asnum", "sortProperty": "asnum", "filterProperty": "asnum"}'
                                                    />
</customData>
<Text id="_IDGenText26" text="Activity number" textAlign="Center" />
                                                </Column>
                                                <Column id='Action' width="70px">
                                                    <customData>
                                                        <core:CustomData key="p13nData" value='\{"columnKey": "Kzgvh", "columnIndex": 4, "columnWidth": "70px"}'
                                                    />
</customData>
<Text id="_IDGenText27" text="Actions" textAlign="Center" />
                                                    </Column>
                                                </columns>

                                                <items>
                                                    <ColumnListItem id="_IDGenColumnListItem4" highlight="{path:'mass_upld_error', formatter:'.formatRowHighlight'}" vAlign="Middle" press="">
                                                        <cells>
                                                            <Text id="_IDGenText28" text="{path:'asnum'}" />
                                                            <Button id="_IDGenButton13" icon="sap-icon://overflow" press=".onActionButtonPress">
                                                                <dependents>
                                                                    <core:Fragment fragmentName="zaidgsmmsup.fragments.ErrorActionFragment" type="XML" />
                                                                </dependents>
                                                            </Button>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </smartTable:SmartTable>
                                    </ScrollContainer>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </f:content>
                <f:footer>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <ToolbarSpacer />
                        <Button text="Show Logs" press="onShowLog" type="Emphasized" visible="{controllModel>/ShowLogBtn}" id="logsButton" />
                        <Button text="Show Status" press="onShowStatus" type="Emphasized" visible="{controllModel>/ShowLogBtn}" id="statusButton" />
                        <Button text="Withdraw" press="onWithdraw" type="Emphasized" visible="{controllModel>/WithdrawBtn}" id="WithdrawButton" />
                        <Button text="Proceed" press="onPressProceedWihoutError" type="Emphasized" visible="{controllModel>/ProceedBtn}" id="proceedButton" />
                        <Button text="Proceed Without Errors" press="onPressProceedWihoutError" type="Emphasized" visible="{controllModel>/ProceedWoErrorBtn}" />
                        <Button text="Cancel" press="onPressCancel" type="Emphasized" visible="true" />
                    </OverflowToolbar>
                </f:footer>
            </f:DynamicPage>
        </mvc:View>
