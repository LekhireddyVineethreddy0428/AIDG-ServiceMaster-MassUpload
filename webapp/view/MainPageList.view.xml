<mvc:View height="100%" controllerName="zaidgsmmsup.controller.MainPageList"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:chart="sap.suite.ui.commons"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:layout="sap.ui.layout"
    xmlns:smartchart="sap.ui.comp.smartchart">
    <f:DynamicPage id="dynamicPage" stickySubheaderProvider="ShoppingCartWizard" class="sapUiNoContentPadding" showFooter="true">
        <f:title >
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Service Master Mass Upload"/>
                </f:heading>
                <f:expandedContent>
                    <Title id="idRequest" text="" />
                </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox alignItems="Center" justifyContent="Center" width="100%" height="50%" backgroundDesign="Transparent">
                <Table id="idMtype_table" inset="false" class='sapUiTinyMarginTop' backgroundDesign="Transparent">
                    <columns>
                        <Column width="14rem">
                            <Text text="Type" />
                        </Column>
                        <Column width="10rem">
                            <Text text="Download Template" />
                        </Column>
                        <Column width="10rem">
                            <Text text="Upload" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active" press="onGetid">
                            <cells>
                                <ObjectIdentifier title="Service Matser" />
                                <Button type="Emphasized" press="onClickDownloadTemplate" icon="sap-icon://download" />
                                <u:FileUploader id="uploadedDoc" fileType="xlsx" sendXHR="true" name="myFileUpload" buttonText="Browse" useMultipart="false" placeholder="Choose a file..." tooltip="Upload your file to the local server" uploadComplete="handleUploadComplete" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <ToolbarSpacer />
                <Button text="Cancel" press="onPressCancel" type="Transparent" />
                <Button press="onSubmitopenFrag" type="Transparent" text='Submit' />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>