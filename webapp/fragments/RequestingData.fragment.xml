<core:FragmentDefinition
    xmlns:smartfield="sap.ui.comp.smartfield"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="requestDialog"
        title="Request Form"
        type="Message"
        contentWidth="35%"
        contentHeight="auto"
        draggable="false"
        resizable="true"
    >
        <content>
            <VBox
                class="sapUiSmallMargin"
                width="90%"
            >
                <!-- Bold Label with F4 Help -->
                <Label
                    text="Request Priority"
                    labelFor="requestPriorityInput"
                    class="sapUiSmallMarginTop"
                    design="Bold"
                />
                <Input
                    id="requestPriorityInput"
                    placeholder="Select priority..."
                    width="100%"
                    showValueHelp="true"
                    valueHelpRequest="onValueHelpRequested"
                    required="true"
                    change=".onPriorityChange"
                    enableSuggestionsHighlighting="true"
                />
                <!-- Bold Label -->
                <Label
                    text="Request Description"
                    labelFor="requestDescriptionInput"
                    design="Bold"
                />
                <Input
                    id="requestDescriptionInput"
                    placeholder="Enter description..."
                    width="100%"
                    required="true"
                />
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Submit"
                type="Accept"
                press="onSubmitExcel"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                type="Reject"
                press="onCancelFrag"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
