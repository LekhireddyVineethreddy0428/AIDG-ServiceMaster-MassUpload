<core:FragmentDefinition xmlns:smartfield="sap.ui.comp.smartfield"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified">
    <Dialog id="requestDialog1" title="Mass Update" type="Message" contentWidth="35%" contentHeight="auto" draggable="false" resizable="true">
        <content>
            <VBox class="sapUiSmallMargin" width="90%">
                <Label text="Upload File" design="Bold" />
                <unified:FileUploader id="fileUploader1" width="100%" fileType="xlsx" sendXHR="true" name="myFileUpload" buttonText="Browse" useMultipart="false" placeholder="Choose a file..." tooltip="Upload your file to the local server" uploadComplete="handleCompleteUpdate"/>
                <Label text="Request Priority" labelFor="requestPriorityInput" class="sapUiSmallMarginTop" design="Bold" />
                <Input id="requestPriorityInput1" placeholder="Select priority..." width="100%" showValueHelp="true" valueHelpRequest="onValueHelpRequestedUpdate" required="true" change=".onPriorityChangeUpdate" enableSuggestionsHighlighting="true" />
                <Label text="Request Description" labelFor="requestDescriptionInput" design="Bold" />
                <Input id="requestDescriptionInput1" placeholder="Enter description..." width="100%" required="true" />
            </VBox>
        </content>
        <beginButton>
            <Button text="Submit" type="Accept" press="onSubmitExcelUpdate" />
        </beginButton>
        <endButton>
            <Button text="Cancel" type="Reject" press="onCancelFragUpdate" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>